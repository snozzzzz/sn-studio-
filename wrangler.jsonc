{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sn-studio",
  "main": "worker.js",
  "compatibility_date": "2026-11-17",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sn-studio-contacts",
      "database_id": "16610a53-af66-4d68-a250-a6bccadb730c"
    }
  ],
  "send_email": [
    {
      "name": "MAILER",
      "destination_address": "snstudiocontact54@gmail.com"
    }
  ]
}
